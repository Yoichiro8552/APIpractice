{
  "openapi": "3.0.0",
  "info": {
    "title": "本データ管理API",
    "version": "1.0.0",
    "description": "Expressを用いた、本のデータ管理APIです。"
  },
  "paths": {
    "/books": {
      "get": {
        "summary": "本の一覧データを取得する",
        "responses": {
          "200": {
            "description": "全ての本のデータの取得に成功しました。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "新しい本を追加する",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "author": {
                    "type": "string"
                  }
                },
                "required": ["title", "author"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "新しい本が追加されました。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "データの入力が正しくありません。"
          }
        }
      }
    },
    "/books/{id}": {
      "put": {
        "summary": "指定されたIDの本のデータを更新する",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "author": {
                    "type": "string"
                  }
                },
                "required": ["title", "author"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "データの更新に成功しました。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "title": {
                      "type": "string"
                    },
                    "author": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "指定されたIDの本が見つかりませんでした。"
          }
        }
      },
      "delete": {
        "summary": "指定されたIDの本のデータを削除する",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "データの削除に成功しました。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "入力したIDの本が見つかりませんでした。"
          }
        }
      }
    }
  }
}
